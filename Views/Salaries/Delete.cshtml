@model EmployeeSalaryManagement.Models.Salary

@{
    ViewData["Title"] = "Delete Salary";
}

<h1>Delete Salary</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Salary</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Employee</dt>
        <dd class="col-sm-10">@(Model.Employee != null ? $"{Model.Employee.Name} {Model.Employee.Surname}" : "-")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SalaryMonth)</dt>
        <dd class="col-sm-10">@(Model.SalaryMonth?.ToString("yyyy-MM-dd") ?? "-")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Employed)</dt>
        <dd class="col-sm-10">@Model.Employed</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.HourlyRate)</dt>
        <dd class="col-sm-10">@(Model.HourlyRate?.ToString("F2") ?? "-")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.HoursWorked)</dt>
        <dd class="col-sm-10">@(Model.HoursWorked?.ToString() ?? "-")</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TotalSalary)</dt>
        <dd class="col-sm-10">@(Model.TotalSalary?.ToString("F2") ?? "-")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="SalaryId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
